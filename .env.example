# Optional IBM watsonx.ai extraction. No key is needed for the offline demo.
# Never commit real credentials. Configure these as server environment variables.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Set a chat-capable model ID available in YOUR watsonx.ai project/region.
WATSONX_MODEL_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Transactional email. MAIL_FROM must belong to your Resend-verified domain.
RESEND_API_KEY=
MAIL_FROM=
APP_ORIGIN=https://rescueloop-live.rescueloop-campus.workers.dev
# Local activation check only; this address is not deployed as a secret.
INTEGRATION_TEST_EMAIL=
# Normally blank. The setup script sets this for a restricted owner-only test.
MAIL_TEST_RECIPIENT=
